# SuperComment web — copy to .env.local and fill in.
# These are PUBLIC client values (anon key is safe to ship); RLS is the security
# boundary. Never put the service_role key here. Never hardcode the project ref
# in source.

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon / publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the public base URL of this app, used to render guest links
# (…/s/<slug>?k=<secret>). If unset, the preview page won't print a full URL.
# e.g. https://app.supercomment.dev
NEXT_PUBLIC_APP_URL=

# --- Cloudflare Turnstile (U4 embedded-review hardening) ---------------------
# Gates the anonymous session mint at /api/review-token/exchange. BOTH are
# OPTIONAL in local dev: when TURNSTILE_SECRET_KEY is UNSET the exchange SKIPS
# verification (with a console note) so dev/demo works without Turnstile.
#
# TURNSTILE_SECRET_KEY (server-only — do NOT prefix NEXT_PUBLIC). When set, the
# exchange requires + verifies a Turnstile token or returns 403.
TURNSTILE_SECRET_KEY=
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY — the matching public site key. Must be wired
# into the overlay boot config (window.__SUPERCOMMENT__.turnstileSiteKey) by the
# embed snippet/loader so the overlay can produce an invisible token. If unset,
# the overlay sends no token (paired with an unset secret = dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
