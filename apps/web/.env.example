# SuperComment web — copy to .env.local and fill in.
# These are PUBLIC client values (anon key is safe to ship); RLS is the security
# boundary. Never put the service_role key here. Never hardcode the project ref
# in source.

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon / publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the public base URL of this app, used to render guest links
# (…/s/<slug>?k=<secret>). If unset, the preview page won't print a full URL.
# e.g. https://app.supercomment.dev
NEXT_PUBLIC_APP_URL=
